# Optional: Gemini API Key for LLM-powered project analysis
# If unset, the system automatically falls back to deterministic heuristic analysis
GEMINI_API_KEY=

# Optional: GitHub Personal Access Token to avoid unauthenticated rate limits (60 req/hr)
# If unset, public unauthenticated requests are used (with graceful fallback on rate limit)
GITHUB_TOKEN=

# Model configuration
GEMINI_MODEL=gemini-2.5-flash
